# Copy to .env and fill in the key for the provider you use.

LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
LLM_FAST_MODEL=claude-haiku-4-5-20251001

# For OpenAI or any OpenAI-compatible endpoint instead:
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-proj-xxx
# OPENAI_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-5
# LLM_FAST_MODEL=gpt-4o-mini

# Cost guard for summaries: max sections read per document (0 = read everything).
SUMMARY_MAX_WINDOWS=150

# Token prices in USD per million tokens, from your provider's price list.
# Used to show cost on the Evaluation page; leave blank to show tokens only.
LLM_PRICE_IN=
LLM_PRICE_OUT=
LLM_FAST_PRICE_IN=
LLM_FAST_PRICE_OUT=

# Model that scores answers during evaluation. Defaults to LLM_MODEL;
# a different model from the one being scored gives a more independent check.
EVAL_JUDGE_MODEL=
